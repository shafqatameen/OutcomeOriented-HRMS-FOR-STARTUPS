# Copy to .env and fill in real values. Never commit .env itself.

# Signs session JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Origin allowed by CORS (the Next.js frontend).
FRONTEND_ORIGIN=http://localhost:3000

# Adds Secure to the session cookie, so browsers only send it over HTTPS.
# Must stay false for local http://localhost development. deploy/install.sh
# sets it to true on the server.
COOKIE_SECURE=false

# Optional. Passwords used by seed.py when creating the initial accounts.
# Leave blank and seed.py generates random ones and prints them once.
SEED_PASSWORD_ABDU=
SEED_PASSWORD_ANNU=
SEED_PASSWORD_SAM=
