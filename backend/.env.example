# Copy to .env and fill in real values. Never commit .env itself.

# Signs session JWTs, and derives the key that encrypts stored Google OAuth
# tokens (app/core/tokenstore.py). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing it later logs everybody out AND makes existing Google Calendar
# connections unreadable, so each person reconnects with two clicks. That is the
# intended behaviour for a rotated secret, not a bug - but it is why rotating
# this is not a free action.
JWT_SECRET_KEY=

# Origin allowed by CORS (the Next.js frontend).
FRONTEND_ORIGIN=http://localhost:3000

# Adds Secure to the session cookie, so browsers only send it over HTTPS.
# Must stay false for local http://localhost development. deploy/install.sh
# sets it to true on the server.
COOKIE_SECURE=false

# Optional. Passwords used by seed.py when creating the initial accounts.
# Leave blank and seed.py generates random ones and prints them once.
SEED_PASSWORD_ABDU=
SEED_PASSWORD_ANNU=
SEED_PASSWORD_SAM=

# Optional. Sign-in addresses for those same accounts. Only ever fills a gap -
# an address already set from the admin page is never overwritten from here.
SEED_EMAIL_ABDU=
SEED_EMAIL_ANNU=
SEED_EMAIL_SAM=

# --- Google Calendar ---
# Leave GOOGLE_CLIENT_ID blank and the integration reports itself unconfigured:
# the Connect button explains what is missing instead of sending anybody to a
# Google error page. Nothing else in the app is affected.
#
# To fill these in, at console.cloud.google.com:
#   1. Create (or pick) a project, and enable the Google Calendar API on it.
#   2. Configure the OAuth consent screen. While it is in "Testing", only the
#      accounts you add as test users can connect - add yours, or publish it.
#   3. Credentials -> Create credentials -> OAuth client ID -> Web application.
#   4. Add GOOGLE_REDIRECT_URI below as an Authorised redirect URI, character
#      for character. Google compares the string, not the URL, so a trailing
#      slash or http-vs-https mismatch is rejected with redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where Google sends the browser back to. This is a BACKEND url - the callback
# is an API endpoint, not a page - and it must be registered on the OAuth client
# above. On a deployed server this becomes your API's public https origin, e.g.
#   https://api.example.com/integrations/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback

# --- Outbound mail (SMTP) ---
# Leave MAIL_HOST blank and nothing is dialled out: every send is printed to the
# backend log instead. That is the intended local-development setting, so no
# developer needs the real mailbox password to work on a mail flow.
MAIL_HOST=
# 587 is STARTTLS, 465 is implicit TLS.
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Defaults to MAIL_USERNAME. Most providers reject a sender that is not the
# authenticated mailbox, so override this only if yours allows it.
MAIL_FROM=
MAIL_FROM_NAME=OutcomeOriented
# Seconds to wait on the mail server before giving up.
MAIL_TIMEOUT=15
# Derived from MAIL_PORT unless set: ssl | starttls | none.
# "none" sends the password in the clear - do not use it against a real mailbox.
MAIL_SECURITY=
