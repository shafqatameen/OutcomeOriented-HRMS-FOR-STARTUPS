# Paste inside the `server { ... }` block of the aaPanel site's Nginx config
# (Website -> your site -> Config File tab). Delete/replace any default
# `location / { ... }` block aaPanel generated — this site is a pure reverse
# proxy, it does not serve static files or PHP from the document root.
#
# The site itself should be created in aaPanel as a plain/static site (PHP
# version: "pure static" / none) — the document root is unused.
#
# Mirrors deploy/Caddyfile: /api/* is stripped of its prefix and forwarded to
# FastAPI on 127.0.0.1:8000; everything else goes to Next.js on :3010 (moved
# off the default :3000 because another site on this box already held it).
# Keeping both behind one origin is deliberate — it keeps the session cookie
# first-party and avoids CORS in the browser.

location /api/ {
    proxy_pass http://127.0.0.1:8000/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location / {
    proxy_pass http://127.0.0.1:3010;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
}
